# MatchPlay Backend — copy this file to .env and fill in your values
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# Required — PostgreSQL connection string
# Render: use Internal Database URL when backend runs on Render;
#         use External Database URL when running scripts from your machine.
#
# Local Postgres example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchplay
#
# Render example:
# DATABASE_URL=postgresql://matchplay_user:YOUR_PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/matchplay
DATABASE_URL=postgresql://matchplay_user:YOUR_PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/matchplay

# Optional — server port (default: 3001)
PORT=3001

# Optional — set to production on Render
NODE_ENV=development

# Optional — protects POST /api/admin/mpr/rebackfill when set.
# Leave empty for local dev (endpoint is open). Frontend does not send this yet.
ADMIN_KEY=
